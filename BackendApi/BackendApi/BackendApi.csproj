<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="iTextSharp.LGPLv2.Core" Version="3.7.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6" />
		<!-- AutoMapper compatible with .NET 8 -->
		<PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />

		<!-- Use SignalR from Microsoft.AspNetCore.SignalR (part of ASP.NET Core 8) -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.Json" Version="8.0.0" />

		<!-- Entity Framework Core for SQL Server -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.6" />

		<!-- Serilog for .NET 8 -->
		<PackageReference Include="Serilog.AspNetCore" Version="8.0.0" />

		<!-- Swagger / OpenAPI for .NET 8 -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />

		<!-- Identity and JWT Auth -->
		<PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.6" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.6" />
		<PackageReference Include="QuestPDF" Version="2024.3.0" />

	</ItemGroup>

	<ItemGroup>
	  <Folder Include="wwwroot\assets\" />
	  <Folder Include="wwwroot\uploads\" />
	</ItemGroup>

</Project>
